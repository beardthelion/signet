{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signet/conformance-report",
  "title": "Signet conformance report",
  "type": "object",
  "required": ["specVersion", "target", "generatedBy", "results", "summary"],
  "properties": {
    "specVersion": { "type": "string", "pattern": "^signet-spec/[0-9]+\\.[0-9]+$" },
    "target": { "type": "string" },
    "generatedBy": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause", "status"],
        "properties": {
          "clause": { "type": "string", "pattern": "^SN-[0-9]{3}$" },
          "status": { "enum": ["pass", "fail", "unsupported"] },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "unsupported"],
      "properties": {
        "pass": { "type": "integer" },
        "fail": { "type": "integer" },
        "unsupported": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
